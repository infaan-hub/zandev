# Zandeveloper MCP Environment Configuration

# Zandeveloper API Configuration
ZANDEV_API_URL=https://zandev.onrender.com/api
ZANDEV_API_KEY=your_api_key_here

# Local Storage
ZANDEV_STORAGE_PATH=./storage

# WebSocket (for real-time sync)
ZANDEV_WS_URL=ws://localhost:3001

# Debug Mode
ZANDEV_DEBUG=false
